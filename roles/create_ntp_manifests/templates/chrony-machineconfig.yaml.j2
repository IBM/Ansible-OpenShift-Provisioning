{% set chrony_conf %}
{% for ntp_server in env.ntp_servers %}
pool {{ ntp_server }} iburst
{% endfor %}
sourcedir /run/chrony-dhcp
driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
{% endset %}
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 99-{{ node_role }}-chrony
  labels:
    machineconfiguration.openshift.io/role: {{ node_role }}
spec:
  config:
    ignition:
      version: 3.2.0
    storage:
      files:
        - path: /etc/chrony.conf
          mode: 420
          overwrite: true
          contents:
            source: data:text/plain;charset=utf-8;base64,{{ chrony_conf | b64encode }}
