apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: "{{ hcp.metallb.ipAddressPool_name | default('metallb', true) }}"
  namespace: "{{ hcp.metallb.namespace | default('metallb-system', true) }}"
spec:
  addresses:
{% set active_ip_pool = metallb_ip_pool | default(hcp.metallb.ip_pool) %}
{% if active_ip_pool is sequence and active_ip_pool is not string %}
{% for address in active_ip_pool if address is not none and (address | string | trim | length > 0) %}
  - "{{ address }}"
{% endfor %}
{% else %}
  - "{{ active_ip_pool }}"
{% endif %}
