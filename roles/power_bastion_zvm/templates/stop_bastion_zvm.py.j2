#!/usr/bin/env python3
"""
Gracefully stop a z/VM guest bastion via tessia-baselib HypervisorZvm.stop().
Generated by Ansible template: power_bastion_zvm/templates/stop_bastion_zvm.py.j2
"""
# macOS compatibility shim — select.epoll() is Linux-only; patch with poll()
import os
import select as _select
if not hasattr(_select, 'epoll'):
    import select
    class _EpollViaPoll:
        EPOLLIN  = _select.POLLIN
        EPOLLOUT = _select.POLLOUT
        def __init__(self):           self._poll = _select.poll()
        def register(self, fd, ev):   self._poll.register(fd, ev)
        def unregister(self, fd):     self._poll.unregister(fd)
        def poll(self, t=None):       return self._poll.poll(None if t is None else int(t * 1000))
        def close(self):              pass
    select.epoll    = _EpollViaPoll
    select.EPOLLIN  = _select.POLLIN
    select.EPOLLOUT = _select.POLLOUT

from tessia.baselib.hypervisors.zvm.zvm import HypervisorZvm

hypervisor_parameters = {"transfer-buffer-size": 8000}

# Password is injected via ZVM_PASS environment variable — never rendered into
# this file so the credential does not appear on disk or in process listings.
_zvm_pass = os.environ.get("ZVM_PASS")
if not _zvm_pass:
    raise RuntimeError("ZVM_PASS environment variable is not set")

zvm = HypervisorZvm(
    "{{ bastion.zvm_name }}",
    "{{ bastion.zvm_host }}",
    "{{ bastion.zvm_user }}",
    _zvm_pass,
    hypervisor_parameters,
)

zvm.login()
print("Logged in to z/VM hypervisor {{ bastion.zvm_host }}")

zvm.stop("{{ bastion.zvm_user }}")
print("Stop signal sent to z/VM guest {{ bastion.zvm_name }}")

zvm.logoff()
print("Logged out from z/VM hypervisor")
