#!/usr/bin/env python3
"""
IPL-boot a z/VM guest bastion from its installed RHEL disk.
Generated by Ansible template: power_bastion_zvm/templates/start_bastion_zvm.py.j2

Unlike create_bastion_zvm (which netboots into a kickstart installer), this
performs a disk IPL to start the already-installed operating system.
"""
# macOS compatibility shim — select.epoll() is Linux-only; patch with poll()
import os
import select as _select
if not hasattr(_select, 'epoll'):
    import select
    class _EpollViaPoll:
        EPOLLIN  = _select.POLLIN
        EPOLLOUT = _select.POLLOUT
        def __init__(self):           self._poll = _select.poll()
        def register(self, fd, ev):   self._poll.register(fd, ev)
        def unregister(self, fd):     self._poll.unregister(fd)
        def poll(self, t=None):       return self._poll.poll(None if t is None else int(t * 1000))
        def close(self):              pass
    select.epoll    = _EpollViaPoll
    select.EPOLLIN  = _select.POLLIN
    select.EPOLLOUT = _select.POLLOUT

from tessia.baselib.hypervisors.zvm.zvm import HypervisorZvm

# ---------------------------------------------------------------------------
# Determine IPL device from bastion configuration
# ---------------------------------------------------------------------------
{% if bastion.disk_type | lower == 'dasd' %}
IPL_DEVICE = "{{ bastion.dasd.disk_id }}"
{% else %}
# FCP: use the first path's FCP channel as the IPL device
IPL_DEVICE = "{{ bastion.fcp.lun[0].paths[0].fcp }}"
{% endif %}

# ---------------------------------------------------------------------------
# Boot parameters: disk IPL, no kernel/initrd injection
# ---------------------------------------------------------------------------
guest_parameters = {
    "boot_method": "disk",
    "storage_volumes": [],
    "ifaces": [],
    "ipl": {
        "ipl_device": IPL_DEVICE,
    },
}

hypervisor_parameters = {"transfer-buffer-size": 8000}

# ---------------------------------------------------------------------------
# Boot the guest
# ---------------------------------------------------------------------------
# Password is injected via ZVM_PASS environment variable — never rendered into
# this file so the credential does not appear on disk or in process listings.
_zvm_pass = os.environ.get("ZVM_PASS")
if not _zvm_pass:
    raise RuntimeError("ZVM_PASS environment variable is not set")

zvm = HypervisorZvm(
    "{{ bastion.zvm_name }}",
    "{{ bastion.zvm_host }}",
    "{{ bastion.zvm_user }}",
    _zvm_pass,
    hypervisor_parameters,
)

zvm.login()
print("Logged in to z/VM hypervisor {{ bastion.zvm_host }}")

zvm.start(
    "{{ bastion.zvm_user }}",
    {{ bastion.resources.vcpu }},
    {{ bastion.resources.ram }},
    guest_parameters,
)
print("z/VM guest {{ bastion.zvm_name }} IPL boot started from device " + IPL_DEVICE)

zvm.logoff()
print("Logged out from z/VM hypervisor")
