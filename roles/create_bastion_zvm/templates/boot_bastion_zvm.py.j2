#!/usr/bin/env python3
"""
Boot z/VM guest for bastion installation using tessia-baselib.
Generated by Ansible template: create_bastion_zvm/templates/boot_bastion_zvm.py.j2
"""
# ---------------------------------------------------------------------------
# macOS compatibility shim for tessia-baselib
#
# tessia-baselib's s3270pipeconnector uses select.epoll(), which is
# Linux-only.  On macOS (Darwin) we inject a wrapper that implements the
# same interface using the portable select.poll() API.
#
# epoll event flags → poll equivalents:
#   EPOLLIN  (1)  → POLLIN  (readable)
#   EPOLLOUT (4)  → POLLOUT (writable)
#
# epoll.poll(timeout) takes seconds (float).
# poll.poll(timeout)  takes milliseconds (int).
# ---------------------------------------------------------------------------
import os
import sys
import select as _select

if not hasattr(_select, 'epoll'):
    import select

    class _EpollViaPoll:
        """Minimal epoll shim backed by select.poll() for non-Linux platforms."""

        EPOLLIN  = _select.POLLIN
        EPOLLOUT = _select.POLLOUT

        def __init__(self):
            self._poll = _select.poll()

        def register(self, fd, eventmask):
            self._poll.register(fd, eventmask)

        def unregister(self, fd):
            self._poll.unregister(fd)

        def poll(self, timeout_secs=None):
            """poll(timeout_secs) → [(fd, event), ...]"""
            if timeout_secs is None:
                ms = None
            else:
                ms = int(timeout_secs * 1000)
            return self._poll.poll(ms)

        def close(self):
            pass

    # Patch the select module so tessia-baselib finds what it expects
    select.epoll   = _EpollViaPoll
    select.EPOLLIN  = _select.POLLIN
    select.EPOLLOUT = _select.POLLOUT

# Only import tessia AFTER the shim is in place
from tessia.baselib.hypervisors.zvm.zvm import HypervisorZvm
import argparse


def main():
    parser = argparse.ArgumentParser(description="Boot z/VM guest for bastion installation")
    parser.add_argument("--zvmname",   required=True, help="z/VM guest user ID (uppercase)")
    parser.add_argument("--zvmhost",   required=True, help="z/VM hypervisor hostname or IP")
    parser.add_argument("--zvmuser",   required=True, help="z/VM administrative user")
    parser.add_argument("--zvmpass",   required=False, default=None,
                        help="z/VM administrative password (prefer ZVM_PASS env var)")
    parser.add_argument("--cpu",       required=True, type=int, help="Number of virtual CPUs")
    parser.add_argument("--memory",    required=True, type=int, help="Memory in MB")
    parser.add_argument("--kernel",    required=True, help="Kernel URI (http:// or file://)")
    parser.add_argument("--initrd",    required=True, help="Initrd URI (http:// or file://)")
    parser.add_argument("--cmdline",   required=True, help="Kernel command line")
    parser.add_argument("--network",   required=True, help="Network type: osa, vswitch, roce, hipersockets")
    parser.add_argument("--znet_id",   required=False, default="",
                        help="Comma-separated subchannel IDs for OSA/HiperSocket (e.g. bdd0,bdd1,bdd2)")
    parser.add_argument("--disk_type", required=True, help="Disk type: ECKD or FCP")
    parser.add_argument("--disk_dev",  action="append", default=[],
                        help="Disk device number (repeatable for FCP multi-path)")
    parser.add_argument("--fcp_rport", action="append", default=[],
                        help="FCP remote port WWPN (repeatable, must match --disk_dev count)")
    parser.add_argument("--fcp_lun",   action="append", default=[],
                        help="FCP LUN ID (repeatable)")
    args = parser.parse_args()

    # Resolve password: env var takes precedence so it never appears in argv/logs.
    zvm_pass = os.environ.get("ZVM_PASS") or args.zvmpass
    if not zvm_pass:
        print("ERROR: z/VM password must be supplied via ZVM_PASS environment variable "
              "or --zvmpass argument.", file=sys.stderr)
        sys.exit(1)

    # ------------------------------------------------------------------
    # Network interface — built at runtime from CLI arguments
    # ------------------------------------------------------------------
    net_lower = args.network.lower()
    if net_lower in ("roce", "pci"):
        ifaces = [{"type": "pci", "id": args.znet_id}]
    else:
        # osa, vswitch, hipersockets — all use the "osa" type in tessia-baselib
        ifaces = [{"type": "osa", "id": args.znet_id}]

    # ------------------------------------------------------------------
    # Storage volumes — passed to HypervisorZvm.start() so tessia-baselib
    # handles the attachment, not vmcp/smcli.
    # ------------------------------------------------------------------
    def _strip_hex(s):
        """Remove leading 0x/0X prefix from a hex string."""
        return s.replace("0x", "").replace("0X", "")

    storage_volumes = []
    if args.disk_type.upper() in ("ECKD", "DASD"):
        for dev in args.disk_dev:
            # devno schema: ^(([a-fA-F0-9]\.){2})?[a-fA-F0-9]{4}$  (e.g. "0B00" or "0.0.0B00")
            storage_volumes.append({"type": "dasd", "devno": _strip_hex(dev)})
    elif args.disk_type.upper() == "FCP":
        # Collect all unique WWPNs first (strip 0x prefix).
        # tessia-baselib wants every adapter to carry the full wwpns list.
        wwpns_clean = []
        for wwpn in args.fcp_rport:
            w = _strip_hex(wwpn)
            if w not in wwpns_clean:
                wwpns_clean.append(w)

        # Each --disk_dev is one HBA adapter; all adapters share the same wwpns list.
        # devno is passed with the full 0.0.XXXX prefix (tessia-baselib schema).
        adapters = []
        for dev in args.disk_dev:
            adapters.append({
                "devno":  dev,                      # e.g. "0.0.8007" (prefix already included)
                "wwpns": wwpns_clean,               # e.g. ["500507630400d1e3", "500507630408d1e3"]
            })

        seen_luns = set()
        for lun in args.fcp_lun:
            clean = _strip_hex(lun)                 # e.g. "400140a000000000"
            if clean not in seen_luns:
                seen_luns.add(clean)
                storage_volumes.append({"type": "fcp", "adapters": adapters, "lun": clean})

    # ------------------------------------------------------------------
    # tessia-baselib guest boot parameters
    # ------------------------------------------------------------------
    guest_parameters = {
        "boot_method": "network",
        "storage_volumes": storage_volumes,
        "ifaces": ifaces,
        "netboot": {
            "cmdline": args.cmdline,
            "kernel_uri": args.kernel,
            "initrd_uri": args.initrd,
        },
    }

    hypervisor_parameters = {"transfer-buffer-size": 8000}

    try:
        print(f"Connecting to z/VM hypervisor: {args.zvmhost}")
        zvm = HypervisorZvm(
            args.zvmname, args.zvmhost, args.zvmuser, zvm_pass,
            hypervisor_parameters,
        )
        zvm.login()
        print(f"✓ Logged in to z/VM hypervisor {args.zvmhost}")

        print(f"Starting guest {args.zvmname} ({args.cpu} vCPU, {args.memory} MB RAM)")
        print(f"  Disk type     : {args.disk_type}")
        print(f"  Storage vols  : {len(storage_volumes)}")
        print(f"  Boot method   : network kickstart")
        zvm.start(args.zvmuser, args.cpu, args.memory, guest_parameters)
        print(f"✓ Guest {args.zvmname} started — kickstart installation in progress")

        zvm.logoff()
        print(f"✓ Logged out from z/VM hypervisor")
        print("")
        print("OS installation is now running on the guest.")
        print("This will take approximately 15–25 minutes.")

    except Exception as exc:
        print(f"✗ Error: {exc}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
