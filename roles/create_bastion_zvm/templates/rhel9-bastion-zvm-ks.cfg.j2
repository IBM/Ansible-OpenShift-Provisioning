# Kickstart for bastion on z/VM — RHEL 9
# Generated by Ansible template: create_bastion_zvm/templates/rhel9-bastion-zvm-ks.cfg.j2

# Reboot after installation
reboot

# Use text mode install
text --non-interactive
# Uncomment next line to debug kickstart install issues
#text

# Run the Setup Agent on first boot
firstboot --enable

# Use network installation
url --url={{ env.file_server.protocol }}://{{ env.file_server.user + ':' + env.file_server.pass + '@' if env.file_server.protocol == 'ftp' else '' }}{{ env.file_server.ip }}{{ ':' + env.file_server.port if env.file_server.port | default('') | length > 0 else '' }}/{{ env.file_server.iso_mount_dir }}

# Add yum repositories
repo --install --name="AppStream" --baseurl={{ env.file_server.protocol }}://{{ env.file_server.user + ':' + env.file_server.pass + '@' if env.file_server.protocol == 'ftp' else '' }}{{ env.file_server.ip }}{{ ':' + env.file_server.port if env.file_server.port | default('') | length > 0 else '' }}/{{ env.file_server.iso_mount_dir }}/AppStream/
repo --install --name="BaseOS"   --baseurl={{ env.file_server.protocol }}://{{ env.file_server.user + ':' + env.file_server.pass + '@' if env.file_server.protocol == 'ftp' else '' }}{{ env.file_server.ip }}{{ ':' + env.file_server.port if env.file_server.port | default('') | length > 0 else '' }}/{{ env.file_server.iso_mount_dir }}/BaseOS/

# Keyboard layouts
keyboard --vckeymap={{ env.keyboard }} --xlayouts='{{ env.keyboard }}'

# System language
lang {{ env.language }}

# System timezone
timezone {{ env.timezone }}

# Mark the End-User License Agreement (EULA) as agreed
eula --agreed

# Network information
# The interface name for z/VM qeth devices uses the ifname defined in the bastion host_vars.
network --bootproto=static --device={{ bastion.networking.interface.ifname }} --ip={{ bastion.networking.ip }} --gateway={{ bastion.networking.gateway }} --netmask={{ bastion.networking.subnetmask }} --nameserver={{ bastion.networking.nameserver1 }}{{ (',' + bastion.networking.nameserver2) if bastion.networking.nameserver2 is defined }} {{ '--ipv6=' + bastion.networking.ipv6 if env.use_ipv6 else '--noipv6' }} {{ '--ipv6gateway=' + bastion.networking.ipv6_gateway if env.use_ipv6 else '' }} --activate
network --hostname={{ bastion.networking.hostname }}.{{ bastion.networking.base_domain }}

# Firewall and SELinux
firewall --enabled --http --ftp --smtp --ssh --port=443,9090
selinux --permissive

# Root password
rootpw --iscrypted {{ _root_pass_hashed }}

# Users and Groups Definitions
user --groups=wheel --name={{ bastion.access.user }} --password={{ _user_pass_hashed }} --iscrypted

{% if bastion.disk_type | lower == 'dasd' %}
# DASD disk layout — device appears as dasda inside the installer
ignoredisk --only-use=dasda
bootloader --append="crashkernel=auto" --location=mbr --boot-drive=dasda
clearpart --all --initlabel --drives=dasda
part /boot --fstype="xfs" --asprimary --ondisk=dasda --size=1024
part pv.01 --fstype="lvmpv" --grow --size=1 --ondisk=dasda
{% else %}
{% set _disk = bastion.fcp.install_disk | default('sda') %}
# FCP disk layout — device name set by bastion.fcp.install_disk (mpatha for multipath, sda for single-path)
ignoredisk --only-use={{ _disk }}
bootloader --append="crashkernel=auto" --location=mbr --boot-drive={{ _disk }}
clearpart --all --initlabel --drives={{ _disk }}
part /boot --fstype="xfs" --asprimary --ondisk={{ _disk }} --size=1024
part pv.01 --fstype="lvmpv" --grow --size=1 --ondisk={{ _disk }}
{% endif %}
volgroup vgsystem --pesize=4096 pv.01
logvol swap --fstype=swap --name=swap --vgname=vgsystem --size={{ bastion.resources.swap | default(4096) }}
logvol /    --fstype=xfs  --name=root --vgname=vgsystem --size=1 --grow

# Packages selection
%packages --multilib --ignoremissing
@^minimal-environment
# Required bastion services
bind
bind-utils
expect
haproxy
httpd
jq
libosinfo
net-tools
python3-pip
rsync
vim
# Required to build cryptography Python module (used by tessia-baselib on bastion)
openssl-devel
python3-devel
redhat-rpm-config
gcc
libffi-devel
cargo
pkg-config
%end

%addon com_redhat_kdump --disable
%end

%post --log=/root/post.log
#!/usr/bin/env bash

# Allow root login (required for RHEL 9).
# RHEL 9 sshd uses drop-in files in /etc/ssh/sshd_config.d/ that override
# the main sshd_config.  50-redhat.conf sets PermitRootLogin prohibit-password.
# We patch both places for safety and add a drop-in that takes highest precedence.
sed -i -e '/PermitRootLogin/ c\PermitRootLogin yes' /etc/ssh/sshd_config
sed -i -e 's/^PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config.d/50-redhat.conf 2>/dev/null || true
echo "PermitRootLogin yes" > /etc/ssh/sshd_config.d/01-permitroot.conf

# Pre-authorize the Ansible controller's SSH public key
echo "{{ lookup('file', path_to_key_pair) }}" >> /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys

# Basic SSH client config
echo "UserKnownHostsFile=/dev/null" >> /root/.ssh/config
echo "StrictHostKeyChecking=no"    >> /root/.ssh/config
chmod 600 /root/.ssh/config

# Yum repository configuration adjustments
echo "gpgcheck=0"              >> /etc/yum.repos.d/AppStream.repo
echo "skip_if_unavailable=True" >> /etc/yum.repos.d/AppStream.repo
echo "gpgcheck=0"              >> /etc/yum.repos.d/BaseOS.repo
echo "skip_if_unavailable=True" >> /etc/yum.repos.d/BaseOS.repo
%end
