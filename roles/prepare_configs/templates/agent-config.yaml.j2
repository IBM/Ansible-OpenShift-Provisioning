apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ env.cluster.networking.metadata_name }}
rendezvousIP: {{ env.cluster.nodes.control.ip[0] }}

{% if installation_type | lower != 'zvm' %}
hosts:
{% for item in range( env.cluster.nodes.control.ip | length ) %}
  - hostname: "{{ env.cluster.nodes.control.hostname[item] }}.{{ env.cluster.networking.metadata_name }}.{{ env.cluster.networking.base_domain }}"
    role: master
{% if installation_type | lower == 'lpar' %}
{%-   set control_node_hostname = env.cluster.nodes.control.vm_name[item] -%}
{%-   set control_node_vars = lookup('file', inventory_dir + '/host_vars/' + control_node_hostname + '.yaml') | from_yaml -%}
{%    if control_node_vars.lpar is defined and control_node_vars.lpar.storage_group_1 is defined %}
{%      if control_node_vars.lpar.storage_group_1.type | lower == 'fcp' %}
    rootDeviceHints:
      deviceName: /dev/disk/by-path/ccw-0.0.{{ control_node_vars.lpar.storage_group_1.dev_num }}-fc-{{ control_node_vars.lpar.storage_group_1.storage_wwpn[0] }}-lun-{{ control_node_vars.lpar.storage_group_1.lun_name }}
{%      elif control_node_vars.lpar.storage_group_1.type | lower == 'dasd' %}
    rootDeviceHints:
      deviceName: /dev/disk/by-path/ccw-0.0.{{ control_node_vars.lpar.storage_group_1.dev_num }}
{%      endif %}
{%    endif %}
{% endif %}
{% if installation_type | lower == 'lpar' %}
{%-   set _ctrl_iface = control_node_vars.networking.device1 -%}
{% else %}
{%-   set _ctrl_iface = 'eth0' -%}
{% endif %}
    interfaces:
      - name: "{{ _ctrl_iface }}"
        macAddress: "{{ env.cluster.nodes.control.mac[item] }}"
    networkConfig:
      interfaces:
        - name: "{{ _ctrl_iface }}"
          type: ethernet
          state: up
          mac-address: "{{ env.cluster.nodes.control.mac[item] }}"
          ipv4:
            enabled: true
            address:
              - ip: "{{ env.cluster.nodes.control.ip[item] }}"
                prefix-length: {{ install_config_vars.machine_network.split('/')[1] }}
            dhcp: false
      dns-resolver:
        config:
          server:
            - "{{ env.bastion.networking.ip }}"
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: "{{ env.bastion.networking.gateway }}"
            next-hop-interface: "{{ _ctrl_iface }}"
            table-id: 254
{% endfor %}
{% if env.cluster.nodes.compute.ip is defined and env.cluster.nodes.compute.ip | select('string') | list | length > 0 %}
{% for item in range( env.cluster.nodes.compute.ip | length ) %}
  - hostname: "{{ env.cluster.nodes.compute.hostname[item] }}.{{ env.cluster.networking.metadata_name }}.{{ env.cluster.networking.base_domain }}"
    role: worker
{% if installation_type | lower == 'lpar' %}
{%   set compute_node_hostname = env.cluster.nodes.compute.vm_name[item] %}
{%   set compute_node_vars = lookup('file', inventory_dir + '/host_vars/' + compute_node_hostname + '.yaml') | from_yaml %}
{%    if compute_node_vars.lpar is defined and compute_node_vars.lpar.storage_group_1 is defined %}
{%      if compute_node_vars.lpar.storage_group_1.type | lower == 'fcp' %}
    rootDeviceHints:
      deviceName: /dev/disk/by-path/ccw-0.0.{{ compute_node_vars.lpar.storage_group_1.dev_num }}-fc-{{ compute_node_vars.lpar.storage_group_1.storage_wwpn[0] }}-lun-{{ compute_node_vars.lpar.storage_group_1.lun_name }}
{%      elif compute_node_vars.lpar.storage_group_1.type | lower == 'dasd' %}
    rootDeviceHints:
      deviceName: /dev/disk/by-path/ccw-0.0.{{ compute_node_vars.lpar.storage_group_1.dev_num }}
{%      endif %}
{%    endif %}
{% endif %}
{% if installation_type | lower == 'lpar' %}
{%-   set _comp_iface = compute_node_vars.networking.device1 -%}
{% else %}
{%-   set _comp_iface = 'eth0' -%}
{% endif %}
    interfaces:
      - name: "{{ _comp_iface }}"
        macAddress: "{{ env.cluster.nodes.compute.mac[item] }}"
    networkConfig:
      interfaces:
        - name: "{{ _comp_iface }}"
          type: ethernet
          state: up
          mac-address: "{{ env.cluster.nodes.compute.mac[item] }}"
          ipv4:
            enabled: true
            address:
              - ip: "{{ env.cluster.nodes.compute.ip[item] }}"
                prefix-length: {{ install_config_vars.machine_network.split('/')[1] }}
            dhcp: false
      dns-resolver:
        config:
          server:
            - "{{ env.bastion.networking.ip }}"
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: "{{ env.bastion.networking.gateway }}"
            next-hop-interface: "{{ _comp_iface }}"
            table-id: 254
{% endfor %}
{% endif %}
{% endif %}
