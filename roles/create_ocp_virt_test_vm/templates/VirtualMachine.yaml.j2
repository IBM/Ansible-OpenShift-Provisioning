{% set _dd = ocp_virt.test_vm.data_disk | default({}) %}
{% set _dd_enabled = _dd.create | default(false) | bool %}
{% set _dd_sc = _dd.storage_class | default(ocp_virt.test_vm.storage_class | default('', true), true) %}
{% set _mig_enabled = (ocp_virt.test_vm.migration | default({})).enabled | default(false) | bool %}
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ ocp_virt.test_vm.name }}
  namespace: {{ ocp_virt.test_vm.namespace }}
spec:
  runStrategy: Always
  dataVolumeTemplates:
  - metadata:
      name: {{ ocp_virt.test_vm.name }}-root
    spec:
      source:
        http:
          url: "{{ ocp_virt.test_vm.image_url }}"
      storage:
{% if ocp_virt.test_vm.storage_class | default('') | length > 0 %}
        storageClassName: {{ ocp_virt.test_vm.storage_class }}
{% endif %}
{% if _mig_enabled %}
        accessModes:
        - ReadWriteMany
{% endif %}
        resources:
          requests:
            storage: {{ ocp_virt.test_vm.disk_size }}
{% if _dd_enabled %}
  - metadata:
      name: {{ ocp_virt.test_vm.name }}-data
    spec:
      source:
        blank: {}
      storage:
{% if _dd_sc | length > 0 %}
        storageClassName: {{ _dd_sc }}
{% endif %}
{% if _mig_enabled %}
        accessModes:
        - ReadWriteMany
{% endif %}
        resources:
          requests:
            storage: {{ _dd.size | default('10Gi', true) }}
{% endif %}
  template:
    metadata:
      labels:
        kubevirt.io/vm: {{ ocp_virt.test_vm.name }}
    spec:
      architecture: s390x
      domain:
        machine:
          type: s390-ccw-virtio
        cpu:
          cores: {{ ocp_virt.test_vm.cpu_cores }}
        memory:
          guest: {{ ocp_virt.test_vm.memory }}
        devices:
          disks:
          - name: rootdisk
            disk:
              bus: virtio
{% if _dd_enabled %}
          - name: datadisk
            serial: datadisk
            disk:
              bus: virtio
{% endif %}
          - name: cloudinit
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
      networks:
      - name: default
        pod: {}
      volumes:
      - name: rootdisk
        dataVolume:
          name: {{ ocp_virt.test_vm.name }}-root
{% if _dd_enabled %}
      - name: datadisk
        dataVolume:
          name: {{ ocp_virt.test_vm.name }}-data
{% endif %}
      - name: cloudinit
        cloudInitNoCloud:
          userData: |
            #cloud-config
            user: cloud-user
{% if ocp_virt.test_vm.ssh_public_key | default('') | length > 0 %}
            ssh_authorized_keys:
            - {{ ocp_virt.test_vm.ssh_public_key }}
{% endif %}
